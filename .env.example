ENVIRONMENT=development
DEBUG=true
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
DATABASE_URL=postgresql+psycopg://osint:change-me@localhost:5432/osint
DATABASE_ECHO=false
ALLOWED_ORIGINS=["http://localhost:5173"]
TRUSTED_HOSTS=["localhost","127.0.0.1","your-api.example.com"]
ENABLE_API_DOCS=true
ENABLE_HSTS=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_BACKEND=memory
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_INVESTIGATION=10/minute
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
# Optional intelligence providers
OPENAI_API_KEY=
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
HIBP_API_KEY=
NUMVERIFY_API_KEY=
DEHASHED_EMAIL=
DEHASHED_API_KEY=
SHODAN_API_KEY=
CENSYS_API_ID=
CENSYS_API_SECRET=
GREYNOISE_API_KEY=
OTX_API_KEY=
SECURITYTRAILS_API_KEY=
# Active third-party URL scanning is privacy-sensitive and disabled by default.
URLSCAN_ACTIVE_SCANNING_ENABLED=false
URLSCAN_VISIBILITY=private
URLSCAN_API_KEY=
# Refresh session cookie (set true behind HTTPS in production)
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_REGISTER=3/minute
RATE_LIMIT_REFRESH=10/minute
# External AI processing is explicit opt-in. Local deterministic reports remain available.
EXTERNAL_AI_PROCESSING_ENABLED=false
AI_REDACT_SENSITIVE_DATA=true
